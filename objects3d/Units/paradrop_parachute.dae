<?xml version="1.0" encoding="utf-8"?>
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset>
    <contributor><authoring_tool>Hand-built for BAR paradrop animation</authoring_tool></contributor>
    <unit name="meter" meter="1"/>
    <up_axis>Y_UP</up_axis>
  </asset>
  <library_effects>
    <effect id="canopy-effect"><profile_COMMON><technique sid="common"><lambert>
      <emission><color>0.05 0.07 0.03 1</color></emission>
      <diffuse><color>0.38 0.48 0.22 1</color></diffuse>
    </lambert></technique></profile_COMMON></effect>
    <effect id="cord-effect"><profile_COMMON><technique sid="common"><lambert>
      <diffuse><color>0.12 0.10 0.07 1</color></diffuse>
    </lambert></technique></profile_COMMON></effect>
  </library_effects>
  <library_materials>
    <material id="canopy-material" name="Canopy"><instance_effect url="#canopy-effect"/></material>
    <material id="cord-material" name="SuspensionLines"><instance_effect url="#cord-effect"/></material>
  </library_materials>
  <library_geometries>
    <geometry id="parachute-mesh" name="Parachute">
      <mesh>
        <source id="parachute-positions">
          <float_array id="parachute-positions-array" count="99">0 0 32 12 0 30 8.485 8.485 30 0 12 30 -8.485 8.485 30 -12 0 30 -8.485 -8.485 30 0 -12 30 8.485 -8.485 30 20 0 24 14.142 14.142 24 0 20 24 -14.142 14.142 24 -20 0 24 -14.142 -14.142 24 0 -20 24 14.142 -14.142 24 0 -0.18 0 0 0.18 0 20 -0.18 24 20 0.18 24 -0.18 0 0 0.18 0 0 -0.18 20 24 0.18 20 24 0 -0.18 0 0 0.18 0 -20 -0.18 24 -20 0.18 24 -0.18 0 0 0.18 0 0 -0.18 -20 24 0.18 -20 24</float_array>
          <technique_common><accessor source="#parachute-positions-array" count="33" stride="3">
            <param name="X" type="float"/><param name="Y" type="float"/><param name="Z" type="float"/>
          </accessor></technique_common>
        </source>
        <source id="parachute-uv">
          <float_array id="parachute-uv-array" count="34">0.5 0.5 0.8 0.5 0.712132 0.712132 0.5 0.8 0.287868 0.712132 0.2 0.5 0.287868 0.287868 0.5 0.2 0.712132 0.287868 1 0.5 0.853553 0.853553 0.5 1 0.146447 0.853553 0 0.5 0.146447 0.146447 0.5 0 0.853553 0.146447</float_array>
          <technique_common><accessor source="#parachute-uv-array" count="17" stride="2">
            <param name="S" type="float"/><param name="T" type="float"/>
          </accessor></technique_common>
        </source>
        <vertices id="parachute-vertices"><input semantic="POSITION" source="#parachute-positions"/></vertices>
        <triangles material="canopy" count="48">
          <input semantic="VERTEX" source="#parachute-vertices" offset="0"/>
          <input semantic="TEXCOORD" source="#parachute-uv" offset="1" set="0"/>
          <p>0 0 1 1 2 2 0 0 2 2 3 3 0 0 3 3 4 4 0 0 4 4 5 5 0 0 5 5 6 6 0 0 6 6 7 7 0 0 7 7 8 8 0 0 8 8 1 1 1 1 9 9 10 10 1 1 10 10 2 2 2 2 10 10 11 11 2 2 11 11 3 3 3 3 11 11 12 12 3 3 12 12 4 4 4 4 12 12 13 13 4 4 13 13 5 5 5 5 13 13 14 14 5 5 14 14 6 6 6 6 14 14 15 15 6 6 15 15 7 7 7 7 15 15 16 16 7 7 16 16 8 8 8 8 16 16 9 9 8 8 9 9 1 1 2 2 1 1 0 0 3 3 2 2 0 0 4 4 3 3 0 0 5 5 4 4 0 0 6 6 5 5 0 0 7 7 6 6 0 0 8 8 7 7 0 0 1 1 8 8 0 0 10 10 9 9 1 1 2 2 10 10 1 1 11 11 10 10 2 2 3 3 11 11 2 2 12 12 11 11 3 3 4 4 12 12 3 3 13 13 12 12 4 4 5 5 13 13 4 4 14 14 13 13 5 5 6 6 14 14 5 5 15 15 14 14 6 6 7 7 15 15 6 6 16 16 15 15 7 7 8 8 16 16 7 7 9 9 16 16 8 8 1 1 9 9 8 8</p>
        </triangles>
        <triangles material="cord" count="16"><input semantic="VERTEX" source="#parachute-vertices" offset="0"/>
          <p>17 19 20 17 20 18 20 19 17 18 20 17 21 23 24 21 24 22 24 23 21 22 24 21 25 27 28 25 28 26 28 27 25 26 28 25 29 31 32 29 32 30 32 31 29 30 32 29</p>
        </triangles>
      </mesh>
    </geometry>
  </library_geometries>
  <library_visual_scenes>
    <visual_scene id="Scene" name="Scene">
      <node id="parachute" name="parachute" type="NODE">
        <rotate sid="parachute-orientation">1 0 0 -90</rotate>
        <scale sid="parachute-scale">1.075 1.075 1.075</scale>
        <instance_geometry url="#parachute-mesh">
          <bind_material><technique_common>
            <instance_material symbol="canopy" target="#canopy-material">
              <bind_vertex_input semantic="UVMap" input_semantic="TEXCOORD" input_set="0"/>
            </instance_material>
            <instance_material symbol="cord" target="#cord-material"/>
          </technique_common></bind_material>
        </instance_geometry>
      </node>
    </visual_scene>
  </library_visual_scenes>
  <scene><instance_visual_scene url="#Scene"/></scene>
</COLLADA>
