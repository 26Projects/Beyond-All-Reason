<?xml version="1.0" encoding="utf-8"?>
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset>
    <contributor><authoring_tool>Hand-built for BAR paradrop animation</authoring_tool></contributor>
    <unit name="meter" meter="1"/>
    <up_axis>Y_UP</up_axis>
  </asset>
  <library_images/>
  <library_effects>
    <effect id="canopy-effect">
      <profile_COMMON>
        <newparam sid="paradrop-parachute-surface">
          <surface type="2D"><init_from>paradrop_parachute_dds</init_from></surface>
        </newparam>
        <newparam sid="paradrop-parachute-sampler">
          <sampler2D><source>paradrop-parachute-surface</source></sampler2D>
        </newparam>
        <technique sid="common"><lambert>
          <emission><color>0 0 0 1</color></emission>
          <diffuse><texture texture="paradrop-parachute-sampler" texcoord="UVMap"/></diffuse>
        </lambert></technique>
      </profile_COMMON>
    </effect>
    <effect id="cord-effect"><profile_COMMON><technique sid="common"><lambert>
      <diffuse><color>0.08 0.09 0.12 1</color></diffuse>
    </lambert></technique></profile_COMMON></effect>
  </library_effects>
  <library_materials>
    <material id="canopy-material" name="Canopy"><instance_effect url="#canopy-effect"/></material>
    <material id="cord-material" name="SuspensionLines"><instance_effect url="#cord-effect"/></material>
  </library_materials>
  <library_geometries>
    <geometry id="parachute-mesh" name="RectangularParachute">
      <mesh>
        <source id="parachute-positions">
          <float_array id="parachute-positions-array" count="75">-22 -16 27.6 0 -16 31.05 22 -16 27.6 -22 0 32.2 0 0 36.8 22 0 32.2 -22 16 27.6 0 16 31.05 22 16 27.6 -16.847 -0.048 12 -17.153 0.048 12 -21.847 -16.048 27.6 -22.153 -15.952 27.6 -17.153 -0.048 12 -16.847 0.048 12 -22.153 15.952 27.6 -21.847 16.048 27.6 17.153 0.048 12 16.847 -0.048 12 22.153 -15.952 27.6 21.847 -16.048 27.6 16.847 0.048 12 17.153 -0.048 12 21.847 16.048 27.6 22.153 15.952 27.6</float_array>
          <technique_common><accessor source="#parachute-positions-array" count="25" stride="3">
            <param name="X" type="float"/><param name="Y" type="float"/><param name="Z" type="float"/>
          </accessor></technique_common>
        </source>
        <source id="parachute-uv">
          <float_array id="parachute-uv-array" count="18">0 0 0.5 0 1 0 0 0.5 0.5 0.5 1 0.5 0 1 0.5 1 1 1</float_array>
          <technique_common><accessor source="#parachute-uv-array" count="9" stride="2">
            <param name="S" type="float"/><param name="T" type="float"/>
          </accessor></technique_common>
        </source>
        <vertices id="parachute-vertices"><input semantic="POSITION" source="#parachute-positions"/></vertices>
        <triangles material="canopy" count="16">
          <input semantic="VERTEX" source="#parachute-vertices" offset="0"/>
          <input semantic="TEXCOORD" source="#parachute-uv" offset="1" set="0"/>
          <p>0 0 1 1 4 4 0 0 4 4 3 3 1 1 2 2 5 5 1 1 5 5 4 4 3 3 4 4 7 7 3 3 7 7 6 6 4 4 5 5 8 8 4 4 8 8 7 7 4 4 1 1 0 0 3 3 4 4 0 0 5 5 2 2 1 1 4 4 5 5 1 1 7 7 4 4 3 3 6 6 7 7 3 3 8 8 5 5 4 4 7 7 8 8 4 4</p>
        </triangles>
        <triangles material="cord" count="16">
          <input semantic="VERTEX" source="#parachute-vertices" offset="0"/>
          <p>9 11 12 9 12 10 12 11 9 10 12 9 13 15 16 13 16 14 16 15 13 14 16 13 17 19 20 17 20 18 20 19 17 18 20 17 21 23 24 21 24 22 24 23 21 22 24 21</p>
        </triangles>
      </mesh>
    </geometry>
  </library_geometries>
  <library_visual_scenes>
    <visual_scene id="Scene" name="Scene">
      <node id="parachute" name="parachute" type="NODE">
        <rotate sid="parachute-orientation">1 0 0 -90</rotate>
        <scale sid="parachute-scale">1.075 1.075 1.075</scale>
        <instance_geometry url="#parachute-mesh">
          <bind_material><technique_common>
            <instance_material symbol="canopy" target="#canopy-material">
              <bind_vertex_input semantic="UVMap" input_semantic="TEXCOORD" input_set="0"/>
            </instance_material>
            <instance_material symbol="cord" target="#cord-material"/>
          </technique_common></bind_material>
        </instance_geometry>
      </node>
    </visual_scene>
  </library_visual_scenes>
  <scene><instance_visual_scene url="#Scene"/></scene>
</COLLADA>
